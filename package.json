{
  "name": "tanstack-start-example-basic-react-query",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "bun --bun vite dev",
    "build:client": "vite build",
    "build:all": "bun run build:desktop bun run build:web",
    "build:desktop": "bun run lingui:compile && bun run build:client && bun scripts/build-desktop.ts",
    "build:web": "bun run lingui:compile && bun run build:client && bun scripts/build-web.ts",
    "preview": "vite preview",
    "start": "bun run dist/server.js",
    "db:seed": "bun --bun src/lib/db/seed.ts",
    "db:studio": "bun --bun drizzle-kit studio",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "tsc --noEmit",
    "lingui:extract": "lingui extract",
    "lingui:compile": "lingui compile --typescript"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@lingui/react": "6.7.0",
    "@monaco-editor/react": "^4.8.0-rc.3",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-query-devtools": "^5.104.0",
    "@tanstack/react-router": "^1.170.39",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.168.58",
    "cn": "latest",
    "drizzle-orm": "^1.0.0-rc.4",
    "handlebars": "^4.7.9",
    "lucide-react": "^1.48.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-intersection-observer": "^11.0.1",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@lingui/vite-plugin": "6.7.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^1.0.0-rc.4",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2003",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.1"
  }
}
